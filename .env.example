# Amazon Associates tag (e.g. yourname-21). Appended to book links for commission.
# Sign up: https://affiliate-program.amazon.in/
NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=mocktestq-21

# Google Search Console verification (meta tag method — recommended).
# In Search Console, choose "HTML tag", copy only the content value, e.g. AbCdEf123...
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools verification (meta tag method).
# In Bing Webmaster, choose "HTML Meta Tag", copy only the content value.
NEXT_PUBLIC_BING_SITE_VERIFICATION=
